{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "SOBA (Backend + Temporal + Frontend)",
      "configurations": [
        "SOBA Backend",
        "SOBA Temporal Worker (soba)",
        "SOBA Frontend"
      ]
    },
    {
      "name": "SOBA (Backend + Temporal + Designer + Forms)",
      "configurations": [
        "SOBA Backend",
        "SOBA Temporal Worker (soba)",
        "SOBA Frontend (Designer)",
        "SOBA Frontend (Forms)"
      ]
    },
    {
      "name": "SOBA (Backend + Temporal)",
      "configurations": ["SOBA Backend", "SOBA Temporal Worker (soba)"]
    }
  ],
  "configurations": [
    {
      "name": "SOBA Start (PowerShell)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/start-soba.ps1"
    },
    {
      "name": "SOBA Stop (PowerShell)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/stop-soba.ps1"
    },
    {
      "name": "SOBA Backend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "corepack",
      "windows": {
        "runtimeExecutable": "corepack.cmd"
      },
      "runtimeArgs": ["pnpm", "dev"],
      "env": {
        "API_BASE_PATH": "/chefs",
        "CORS_DEV_ORIGIN": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100,http://localhost:3101,http://127.0.0.1:3101",
        "NODE_ENV": "development",
        "DATABASE_URL": "postgres://postgres:postgres@localhost:5432/soba"
      },
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "SOBA Temporal Worker (soba)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "corepack",
      "windows": {
        "runtimeExecutable": "corepack.cmd"
      },
      "runtimeArgs": ["pnpm", "exec", "tsx", "watch", "temporal-worker.ts"],
      "env": {
        "TEMPORAL_TASK_QUEUE": "soba",
        "TEMPORAL_WORKER_HEALTH_PORT": "9090"
      },
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "SOBA Temporal Worker (document-generation)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "corepack",
      "windows": {
        "runtimeExecutable": "corepack.cmd"
      },
      "runtimeArgs": ["pnpm", "exec", "tsx", "watch", "temporal-worker.ts"],
      "env": {
        "TEMPORAL_TASK_QUEUE": "document-generation",
        "TEMPORAL_WORKER_HEALTH_PORT": "9091"
      },
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "SOBA Frontend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "corepack",
      "windows": {
        "runtimeExecutable": "corepack.cmd"
      },
      "runtimeArgs": ["pnpm", "dev:combined"],
      "env": {
        "NEXT_PUBLIC_SOBA_API_BASE_URL": "http://localhost:4000/chefs/api/v1",
        "SOBA_API_INTERNAL_URL": "http://localhost:4000/chefs/api/v1"
      },
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "SOBA Frontend (Designer)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "corepack",
      "windows": {
        "runtimeExecutable": "corepack.cmd"
      },
      "runtimeArgs": ["pnpm", "dev:designer"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "SOBA Frontend (Forms)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "corepack",
      "windows": {
        "runtimeExecutable": "corepack.cmd"
      },
      "runtimeArgs": ["pnpm", "dev:forms"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "SOBA Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000/chefs",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "SOBA Frontend Forms (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3100/forms",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "SOBA Frontend Designer (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3101/designer",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "MinIO",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Start MinIO Container",
      "program": "${workspaceFolder}",
      "runtimeExecutable": "echo",
      "runtimeArgs": ["MinIO command sent successfully!"]
    },
    {
      "name": "ClamAV",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Start ClamAV Container",
      "program": "${workspaceFolder}",
      "runtimeExecutable": "echo",
      "runtimeArgs": ["ClamAV command sent successfully!"]
    },
    {
      "name": "Valkey",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Start Valkey Container",
      "program": "${workspaceFolder}",
      "runtimeExecutable": "echo",
      "runtimeArgs": ["Valkey command sent successfully!"]
    }
  ]
}
