        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SOBA Playwright login" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.nio.charset.StandardCharsets
import java.nio.file.Files
import java.nio.file.Paths
import java.util.concurrent.TimeUnit
import org.apache.jmeter.services.FileServer

def stage = 'locating Playwright next to the JMeter plan'
try {
    def helper = Paths.get(FileServer.getFileServer().getBaseDir()).resolve('playwright-login.cjs')
    if (!Files.isRegularFile(helper)) {
        throw new IOException('The Playwright login helper is missing.')
    }

    stage = 'preparing the Playwright login'
    def port = vars.get('api_port')?.trim()
    def meUrl = new URI(vars.get('api_protocol'), null, vars.get('api_host'),
        port ? port.toInteger() : -1, vars.get('api_base_path') + '/me', null, null)
    def workDir = Files.createTempDirectory('soba-jmeter-')
    def tokenFile = workDir.resolve('access-token')
    def token
    try {
        def builder = new ProcessBuilder('node', helper.toString(), meUrl.toString(), tokenFile.toString(),
            vars.get('playwright_base_url')?.trim() ?: '')
        builder.redirectErrorStream(true)
        builder.redirectOutput(new File(System.getProperty('os.name').startsWith('Windows') ? 'NUL' : '/dev/null'))

        stage = 'starting Node and Playwright'
        def process = builder.start()
        try {
            stage = 'waiting for the Playwright login (check the credentials, Chromium, and frontend and API URLs)'
            if (!process.waitFor(120, TimeUnit.SECONDS) || process.exitValue() != 0) {
                throw new IOException('Playwright did not complete the login.')
            }

            stage = 'reading the SOBA access token'
            token = new String(Files.readAllBytes(tokenFile), StandardCharsets.UTF_8).trim()
            if (!token) throw new IOException('Playwright returned an empty token.')
            stage = 'removing temporary Playwright files'
        } finally {
            if (process.isAlive()) {
                process.destroyForcibly()
                process.waitFor(5, TimeUnit.SECONDS)
            }
        }
    } finally {
        Files.deleteIfExists(tokenFile)
        Files.deleteIfExists(workDir)
    }
    props.setProperty('soba.run.access_token', token)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseMessage('SOBA access token ready')
} catch (Exception failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode('500')
    SampleResult.setResponseMessage("Failed while ${stage}")
}
</stringProp>
          </JSR223Sampler>
