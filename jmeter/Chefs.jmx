        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP headers" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Accept</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">${__groovy(def token = vars.get('playwright_login') == 'true' ? props.getProperty('soba.run.access_token') : vars.get('access_token'); token ? 'Bearer ' + token : '')}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree />
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Prepare SOBA IDs and payload" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import org.apache.jorphan.util.JMeterStopThreadException

if (!vars.get('form_id')?.trim()) {
    throw new JMeterStopThreadException('Set form_id to a published SOBA form before running.')
}
// RFC 9562 UUIDv7: 48-bit Unix milliseconds, version 7, random RFC 4122 variant tail.
def uuid7 = {
    def timestamp = String.format('%012x', System.currentTimeMillis())
    def random = UUID.randomUUID().toString()
    timestamp.substring(0, 8) + '-' + timestamp.substring(8) + '-7' +
        random.substring(15, 18) + random.substring(18)
}
def dataFile = vars.get('data_file')?.trim()
def answers = dataFile ? new JsonSlurper().parse(new File(dataFile), 'UTF-8') : [
    simpletextarea: 'some',
    simplecheckboxes: [male: true, female: false],
    simpletextfield: 'ewr',
    lateEntry: false,
    submit: true
]
if (!(answers instanceof Map)) {
    throw new JMeterStopThreadException('data_file must contain a JSON object of form answers.')
}
vars.put('submission_id', uuid7())
vars.put('revision_id', uuid7())
vars.remove('base_revision_id')
vars.put('answers_json', JsonOutput.toJson(answers))
vars.put('open_body', JsonOutput.toJson([id: vars.get('submission_id'), formId: vars.get('form_id').trim()]))
</stringProp>
          </JSR223PreProcessor>
          <hashTree />
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract base_revision_id" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">base_revision_id</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.headRevisionId</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">MISSING</stringProp>
          </JSONPostProcessor>
          <hashTree />
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Require the opened submission and its head revision" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
assert prev.getResponseCode() in ['200', '201']
assert body.id == vars.get('submission_id')
assert body.headRevisionId instanceof String &amp;&amp; body.headRevisionId ==~ /[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/
</stringProp>
          </JSR223Assertion>
