          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build submit payload from opened revision" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import org.apache.jorphan.util.JMeterStopThreadException

def base = vars.get('base_revision_id')
if (!base || base == 'MISSING') {
    throw new JMeterStopThreadException('Open submission did not return headRevisionId; submit was not sent.')
}
vars.put('submit_body', JsonOutput.toJson([
    data: new JsonSlurper().parseText(vars.get('answers_json')),
    revisionId: vars.get('revision_id'),
    baseRevisionId: base
]))
</stringProp>
          </JSR223PreProcessor>
          <hashTree />
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Require a submitted current revision" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
assert prev.getResponseCode() == '200'
assert body.id == vars.get('submission_id')
assert body.workflowState == 'submitted'
assert body.revision?.status == 'current'
assert body.revision?.id == vars.get('revision_id')
