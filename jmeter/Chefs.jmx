      <hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Playwright login enabled" enabled="true">
          <stringProp name="IfController.condition">${__groovy(vars.get('playwright_login') == 'true')}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
