{
  "git": {
    "requireUpstream": false,
    "commit": false,
    "tag": false,
    "push": false
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "ignoreRecommendedBump": true,
      "preset": {
        "name": "conventionalcommits"
      }
    },
    "@release-it/bumper": {
      "out": [
        "backend/package.json",
        "frontend/package.json",
        "lib/package.json"
      ]
    }
  }
}
