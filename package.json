{
  "name": "soba",
  "version": "2.0.0-beta.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm build:lib && pnpm build:frontend && pnpm build:backend",
    "build:lib": "pnpm --filter @soba/lib run build",
    "build:frontend": "pnpm --filter frontend run build",
    "build:backend": "pnpm --filter backend run build",
    "test": "pnpm test:lib && pnpm test:frontend && pnpm test:backend",
    "test:lib": "pnpm --filter @soba/lib run test",
    "test:frontend": "pnpm --filter frontend run test",
    "test:backend": "pnpm --filter backend run test",
    "lint": "pnpm lint:lib && pnpm lint:frontend && pnpm lint:backend",
    "lint:fix": "pnpm lint:fix:lib && pnpm lint:fix:frontend && pnpm lint:fix:backend",
    "lint:lib": "pnpm --filter @soba/lib run lint",
    "lint:frontend": "pnpm --filter frontend run lint",
    "lint:backend": "pnpm --filter backend run lint",
    "lint:fix:lib": "pnpm --filter @soba/lib run lint:fix",
    "lint:fix:frontend": "pnpm --filter frontend run lint:fix",
    "lint:fix:backend": "pnpm --filter backend run lint:fix",
    "check": "pnpm check:lib && pnpm check:frontend && pnpm check:backend",
    "check:lib": "pnpm --filter @soba/lib run check",
    "check:frontend": "pnpm --filter frontend run check",
    "check:backend": "pnpm --filter backend run check",
    "qa": "pnpm check && pnpm test",
    "qa:build": "pnpm qa && pnpm build",
    "db:migrate": "pnpm --filter @soba/backend run db:migrate",
    "db:seed": "pnpm --filter @soba/backend run db:seed",
    "db:dev-data": "pnpm --filter @soba/backend run db:dev-data",
    "db:init": "pnpm db:migrate && pnpm db:seed",
    "dev:services:up": "docker compose -f .devcontainer/docker-compose.yml up -d --wait",
    "dev:db:up": "pnpm dev:services:up && pnpm db:init",
    "clean:workspace": "bash scripts/clean-workspace.sh",
    "clean:workspace:full": "bash scripts/clean-workspace.sh --full -y"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2"
}
