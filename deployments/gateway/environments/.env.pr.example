# Temporary PR gateway in the development namespace.
# Fill in the empty values. Export PR_NUMBER before sourcing this file.
GATEWAY_ID=''
# Use a distinct supported hostname for each PR with the current template.
# A hostname pattern can reference ${PR_NUMBER} inside double quotes.
GATEWAY_HOSTNAME=''
OPENSHIFT_NAMESPACE=''
PR_NUMBER="${PR_NUMBER:?Export PR_NUMBER before sourcing the PR environment file}"
GATEWAY_SERVICE_NAME="soba-pr-${PR_NUMBER}-dev"
BACKEND_HOST="soba-pr-${PR_NUMBER}-backend.${OPENSHIFT_NAMESPACE}.svc"

GATEWAY_QUALIFIER="pr-${PR_NUMBER}"
